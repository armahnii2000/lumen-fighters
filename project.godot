; Engine configuration file.
; Juego de Pelea Shotos — Fase 0 (esqueleto)
; Godot 4.x

config_version=5

[application]

config/name="Juego de Pelea Shotos"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://globals/game_config.gd"
ControllerSetup="*res://globals/controller_setup.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

